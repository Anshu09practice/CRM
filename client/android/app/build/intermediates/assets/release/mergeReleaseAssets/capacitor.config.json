{
	"appId": "com.jalanjyothi.crm",
	"appName": "JJ CRM",
	"webDir": "dist",
	"android": {
		"allowMixedContent": false,
		"backgroundColor": "#f8fafc"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"backgroundColor": "#4f46e5",
			"showSpinner": true,
			"spinnerColor": "#ffffff"
		},
		"StatusBar": {
			"backgroundColor": "#4f46e5",
			"style": "LIGHT"
		},
		"Keyboard": {
			"resize": "body",
			"style": "dark",
			"resizeOnFullScreen": true
		}
	},
	"server": {
		"androidScheme": "https",
		"cleartext": false
	}
}
