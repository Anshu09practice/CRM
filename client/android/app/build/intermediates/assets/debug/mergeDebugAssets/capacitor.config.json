{
	"appId": "com.jalanjyothi.crm",
	"appName": "JJ CRM",
	"webDir": "dist",
	"android": {
		"allowMixedContent": true,
		"backgroundColor": "#f8fafc"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"backgroundColor": "#1e40af",
			"showSpinner": true,
			"spinnerColor": "#ffffff"
		},
		"StatusBar": {
			"backgroundColor": "#1e40af"
		}
	},
	"server": {
		"androidScheme": "https",
		"cleartext": true
	}
}
