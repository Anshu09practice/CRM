# JJ CRM Server Configuration
# Copy this file to .env and configure your values

# Server
PORT=3001
NODE_ENV=development

# Security
JWT_SECRET=your-secure-random-secret-minimum-32-chars
ALLOWED_ORIGINS=http://localhost:5173,https://localhost:3001,capacitor://localhost

# SSL/TLS
# Set HTTP_MODE=true when behind a reverse proxy (nginx, cloudflare, etc.)
HTTP_MODE=false
NO_SSL=false

# Database
# Default: SQLite (no config needed)
# For PostgreSQL, set both:
# DB_PROVIDER=postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/jj_crm

# Rate Limiting (defaults shown)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=200
# AUTH_RATE_LIMIT_MAX=10
