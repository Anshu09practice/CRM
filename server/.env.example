# JJ CRM Server Configuration
# Copy this file to .env and configure your values

# Server
PORT=3001
NODE_ENV=production

# === PCI DSS 3.4.1: Authentication Secret ===
# REQUIRED for production. Must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# === PCI DSS 3.4: Data Encryption Key (for customer PII at rest) ===
# If not set, falls back to JWT_SECRET. For best practice, use a separate key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# === PCI DSS 6.5.9: CORS Allowed Origins ===
# Whitelist only your known domains (no wildcards, no private IP ranges)
ALLOWED_ORIGINS=https://yourdomain.com,capacitor://localhost

# === PCI DSS 4.1: TLS Configuration ===
# HTTP_MODE=true ONLY when behind a TLS-terminating reverse proxy
# BOTH must be set together. Plain HTTP without proxy is BLOCKED.
HTTP_MODE=false
TRUSTED_PROXY=false

# Database
# Default: SQLite (no config needed)
# For PostgreSQL, set both:
# DB_PROVIDER=postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/jj_crm

# Rate Limiting (defaults shown)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=200
# AUTH_RATE_LIMIT_MAX=10
